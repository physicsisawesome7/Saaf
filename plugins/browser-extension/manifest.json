{
  "manifest_version": 3,
  "name": "Saaf: PII guard for AI chats",
  "short_name": "Saaf",
  "version": "0.2.0",
  "description": "Masks Aadhaar, PAN, card numbers, emails and other personal data before you send them to ChatGPT, Claude, Gemini or any AI chat. Runs on your device.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://grok.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://grok.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Saaf",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/saaf-16.png", "32": "icons/saaf-32.png", "48": "icons/saaf-48.png" }
  },
  "icons": { "16": "icons/saaf-16.png", "32": "icons/saaf-32.png", "48": "icons/saaf-48.png", "128": "icons/saaf-128.png" },
  "homepage_url": "https://safearly.com/saaf/extension"
}
