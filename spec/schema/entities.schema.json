{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safearly/saaf/spec/schema/entities.schema.json",
  "title": "Saaf detector spec",
  "type": "object",
  "required": ["spec_version", "entities"],
  "properties": {
    "$schema": { "type": "string" },
    "spec_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "defaults": {
      "type": "object",
      "properties": {
        "context_window": { "type": "integer", "minimum": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "context_sets": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    },
    "entities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entity" } }
  },
  "additionalProperties": false,
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "pattern": {
      "type": "object",
      "required": ["pattern"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1 },
        "flags": { "type": "string", "pattern": "^i?$" },
        "group": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["id", "patterns"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "label": { "type": "string" },
        "phase": { "enum": ["P0", "P1", "P2"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "canonical": { "enum": ["digits", "alnum_upper", "lower", "strip"] },
        "patterns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pattern" } },
        "validator": {
          "enum": ["verhoeff", "aadhaar", "luhn", "card", "pan", "gstin", "ifsc", "upi_handle", "in_mobile", "in_state_code", "udyam"]
        },
        "on_invalid": { "enum": ["drop", "base"] },
        "base_score": { "$ref": "#/$defs/score" },
        "validated_score": { "$ref": "#/$defs/score" },
        "requires_context": { "type": "boolean" },
        "context": { "$ref": "#/$defs/keywords" },
        "context_boost": { "$ref": "#/$defs/score" },
        "negative_context": {
          "oneOf": [{ "$ref": "#/$defs/keywords" }, { "type": "string", "pattern": "^@[a-z_]+$" }]
        },
        "negative_penalty": { "$ref": "#/$defs/score" },
        "ocr": {
          "type": "object",
          "required": ["pattern", "shape", "score"],
          "properties": {
            "pattern": { "type": "string" },
            "flags": { "type": "string", "pattern": "^i?$" },
            "shape": { "type": "string", "pattern": "^[DL]+$" },
            "min_digits": { "type": "integer", "minimum": 0 },
            "score": { "$ref": "#/$defs/score" }
          },
          "additionalProperties": false
        },
        "fake": { "enum": ["aadhaar", "in_mobile"] }
      },
      "additionalProperties": false
    }
  }
}
