    {
      "id": "BANK_ACCOUNT",
      "label": "Bank account number",
      "phase": "P0",
      "severity": "high",
      "priority": 20,
      "canonical": "digits",
      "patterns": [
        { "pattern": "(?<![0-9])[0-9]{9,18}(?![0-9])" }
