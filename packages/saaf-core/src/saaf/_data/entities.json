    {
      "id": "IFSC",
      "label": "IFSC bank branch code",
      "phase": "P0",
      "severity": "low",
      "priority": 60,
      "canonical": "alnum_upper",
      "patterns": [
        { "pattern": "(?<![A-Za-z0-9])[A-Z]{4}0[A-Z0-9]{6}(?![A-Za-z0-9])" }
      ],
      "validator": "ifsc",
      "on_invalid": "drop",
      "validated_score": 0.55,
      "context": ["ifsc", "ifsc code", "branch", "bank", "neft", "rtgs", "imps"],
      "context_boost": 0.3
    },
    {
      "id": "ABHA_ADDRESS",
      "label": "ABHA address",
      "phase": "P1",
      "severity": "high",
      "priority": 96,
      "canonical": "lower",
      "patterns": [
        { "pattern": "(?<![A-Za-z0-9._])[A-Za-z0-9][A-Za-z0-9._]{2,31}@(?:abdm|sbx)(?![A-Za-z0-9])", "flags": "i" }
      ],
      "base_score": 0.95
    },
    {
      "id": "UPI_ID",
      "label": "UPI virtual payment address",
      "phase": "P0",
      "severity": "medium",
      "priority": 80,
      "canonical": "lower",
      "patterns": [
        { "pattern": "(?<![A-Za-z0-9._\\-])[A-Za-z0-9][A-Za-z0-9._\\-]{1,255}@[A-Za-z][A-Za-z0-9]{1,63}(?![A-Za-z0-9@\\-]|\\.[A-Za-z])" }
      ],
      "validator": "upi_handle",
      "on_invalid": "base",
      "base_score": 0.4,
      "validated_score": 0.9,
      "context": ["upi", "vpa", "upi id", "gpay", "google pay", "phonepe", "paytm", "bhim", "pay to", "send to"],
      "context_boost": 0.3
    },
    {
      "id": "EMAIL",
      "label": "Email address",
      "phase": "P0",
      "severity": "medium",
      "priority": 75,
      "canonical": "lower",
      "patterns": [
        { "pattern": "(?<![A-Za-z0-9._%+\\-])[A-Za-z0-9._%+\\-]+@[A-Za-z0-9\\-]+(?:\\.[A-Za-z0-9\\-]+)*\\.[A-Za-z]{2,24}(?![A-Za-z0-9])" }
      ],
      "base_score": 0.9
    },
    {
      "id": "PHONE_IN",
      "label": "Indian mobile number",
      "phase": "P0",
      "severity": "medium",
      "priority": 65,
      "canonical": "digits",
      "patterns": [
        { "pattern": "(?<![0-9A-Za-z+])(?:(?:\\+|00)91[ -]?|0)?[6-9][0-9]{4}[ -]?[0-9]{5}(?![0-9])" },
        { "pattern": "(?<![0-9A-Za-z+])(?:(?:\\+|00)91[ -]?|0)?[6-9][0-9]{2}[ -][0-9]{3}[ -][0-9]{4}(?![0-9])" }
      ],
      "validator": "in_mobile",
      "on_invalid": "drop",
      "validated_score": 0.7,
      "context": ["phone", "mobile", "mob", "mob no", "cell", "call", "whatsapp", "contact", "number", "फोन", "मोबाइल", "नंबर"],
      "context_boost": 0.2,
      "negative_context": "@numeric_negative",
      "negative_penalty": 0.4,
      "fake": "in_mobile"
    },
    {
      "id": "CREDIT_CARD",
      "label": "Payment card number",
      "phase": "P0",
      "severity": "high",
      "priority": 88,
      "canonical": "digits",
      "patterns": [
        { "pattern": "(?<![0-9])[0-9](?:[ -]?[0-9]){12,18}(?![0-9])" }
      ],
      "validator": "card",
      "on_invalid": "drop",
      "validated_score": 0.9,
      "context": ["card", "credit card", "debit card", "cc", "visa", "mastercard", "rupay", "amex"],
      "context_boost": 0.1,
      "negative_context": "@numeric_negative",
      "negative_penalty": 0.3
    },
    {
      "id": "ABHA_NUMBER",
      "label": "ABHA health ID number",
      "phase": "P1",
      "severity": "high",
      "priority": 72,
      "canonical": "digits",
      "patterns": [
        { "pattern": "(?<![0-9])[0-9]{2}([ -]?)[0-9]{4}\\1[0-9]{4}\\1[0-9]{4}(?![0-9])" }
