      ],
      "base_score": 0.45,
      "requires_context": true,
      "context": ["tan", "tan no", "tds", "tax deduction"],
      "context_boost": 0.4
    },
    {
      "id": "UDYAM",
      "label": "Udyam registration number",
      "phase": "P1",
      "severity": "low",
      "priority": 92,
      "canonical": "alnum_upper",
      "patterns": [
        { "pattern": "(?<![A-Za-z0-9])UDYAM-[A-Z]{2}-[0-9]{2}-[0-9]{7}(?![0-9])", "flags": "i" }
      ],
      "validator": "udyam",
      "on_invalid": "drop",
      "validated_score": 0.95
    },
    {
      "id": "PIN_CODE",
      "label": "Postal PIN code",
      "phase": "P1",
      "severity": "low",
      "priority": 15,
      "canonical": "digits",
      "patterns": [
        { "pattern": "(?<![0-9])[1-9][0-9]{2} ?[0-9]{3}(?![0-9])" }
