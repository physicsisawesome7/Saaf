      "label": "Voter ID (EPIC)",
      "phase": "P0",
      "severity": "high",
      "priority": 55,
      "canonical": "alnum_upper",
      "patterns": [
        { "pattern": "(?<![A-Za-z0-9])[A-Z]{3}[0-9]{7}(?![A-Za-z0-9])" }
