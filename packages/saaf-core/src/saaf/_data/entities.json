      "phase": "P0",
      "severity": "high",
      "priority": 58,
      "canonical": "alnum_upper",
      "patterns": [
        { "pattern": "(?<![A-Za-z0-9])[A-Z]{2}[ -]?[0-9]{2}[ -]?(?:19|20)[0-9]{2}[ -]?[0-9]{7}(?![A-Za-z0-9])" }
