      "base_score": 0.3,
      "requires_context": true,
      "context": ["pin", "pincode", "pin code", "postal code", "zip", "पिन"],
      "context_boost": 0.35
    },
    {
      "id": "DATE_OF_BIRTH",
      "label": "Date of birth",
      "phase": "P1",
      "severity": "medium",
      "priority": 45,
      "canonical": "strip",
      "patterns": [
        { "pattern": "(?<![0-9])(?:0?[1-9]|[12][0-9]|3[01])([/.\\-])(?:0?[1-9]|1[0-2])\\1(?:19|20)[0-9]{2}(?![0-9])" }
      ],
      "base_score": 0.3,
      "requires_context": true,
      "context": ["dob", "d.o.b", "date of birth", "born", "birth", "birthday", "जन्म", "janm"],
      "context_boost": 0.45
    },
    {
      "id": "PERSON",
      "label": "Person name (honorific rule)",
      "phase": "P1",
      "severity": "medium",
      "priority": 30,
      "canonical": "strip",
      "patterns": [
        { "pattern": "(?<![A-Za-z])(?:Mr|Mrs|Ms|Miss|Dr|Shri|Smt|Sri|Kumari|Km)\\.? ([A-Z][a-z]+(?: [A-Z][a-z]+){0,2})", "group": 1 }
      ],
      "base_score": 0.6
    },
    {
      "id": "SECRET",
      "label": "API key or secret",
      "phase": "P0",
      "severity": "critical",
      "priority": 99,
      "canonical": "strip",
      "patterns": [
        { "pattern": "(?<![A-Za-z0-9_])rzp_(?:live|test)_[A-Za-z0-9]{14,}" },
        { "pattern": "(?<![A-Za-z0-9])AKIA[0-9A-Z]{16}(?![A-Za-z0-9])" },
        { "pattern": "(?<![A-Za-z0-9_])sk-ant-[A-Za-z0-9_\\-]{20,}" },
        { "pattern": "(?<![A-Za-z0-9_])sk-(?:proj-)?[A-Za-z0-9_\\-]{20,}" },
        { "pattern": "(?<![A-Za-z0-9_])gh[pousr]_[A-Za-z0-9]{36,}" },
        { "pattern": "(?<![A-Za-z0-9_])xox[baprs]-[A-Za-z0-9\\-]{10,}" }
      ],
      "base_score": 0.95
    }
  ]
}
