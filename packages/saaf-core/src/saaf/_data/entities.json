      "base_score": 0.35,
      "requires_context": true,
      "context": ["account", "account no", "account number", "a/c", "ac no", "acct", "acc no", "savings", "current account", "खाता", "khata"],
      "context_boost": 0.4,
      "negative_context": "@numeric_negative",
      "negative_penalty": 0.4
    },
    {
