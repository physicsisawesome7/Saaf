{
  "$schema": "./schema/entities.schema.json",
  "spec_version": "0.1.0",
  "defaults": {
    "context_window": 50,
    "threshold": 0.5
  },
  "context_sets": {
    "numeric_negative": [
      "order", "order id", "order no", "invoice", "inv no", "txn", "transaction id", "txn id",
      "ref", "ref no", "reference", "awb", "tracking", "booking", "pnr", "ticket", "sku",
      "serial", "utr", "otp", "batch", "lot", "imei", "hsn"
    ]
  },
  "entities": [
    {
      "id": "AADHAAR",
      "label": "Aadhaar number",
      "phase": "P0",
      "severity": "high",
      "priority": 90,
      "canonical": "digits",
      "patterns": [
        { "pattern": "(?<![0-9])[2-9][0-9]{3}([ -]?)[0-9]{4}\\1[0-9]{4}(?![0-9])" }
      ],
      "validator": "aadhaar",
      "on_invalid": "drop",
      "validated_score": 0.65,
      "context": ["aadhaar", "aadhar", "adhaar", "adhar", "aadhaar no", "uid", "uidai", "eaadhaar", "e-aadhaar", "आधार"],
      "context_boost": 0.3,
      "negative_context": "@numeric_negative",
      "negative_penalty": 0.4,
      "ocr": {
        "pattern": "(?<![0-9A-Za-z])[2-9OoIlSB][0-9OoIlSB]{3}[ -]?[0-9OoIlSB]{4}[ -]?[0-9OoIlSB]{4}(?![0-9A-Za-z])",
        "shape": "DDDDDDDDDDDD",
        "min_digits": 8,
        "score": 0.55
      },
      "fake": "aadhaar"
    },
    {
      "id": "AADHAAR_VID",
      "label": "Aadhaar Virtual ID",
      "phase": "P1",
      "severity": "high",
      "priority": 70,
      "canonical": "digits",
      "patterns": [
        { "pattern": "(?<![0-9])[0-9]{4}([ -]?)[0-9]{4}\\1[0-9]{4}\\1[0-9]{4}(?![0-9])" }
      ],
      "validator": "verhoeff",
      "on_invalid": "drop",
      "validated_score": 0.3,
      "requires_context": true,
      "context": ["vid", "virtual id", "aadhaar", "aadhar"],
      "context_boost": 0.5
    },
    {
      "id": "PAN",
      "label": "Permanent Account Number",
      "phase": "P0",
      "severity": "high",
      "priority": 85,
      "canonical": "alnum_upper",
      "patterns": [
        { "pattern": "(?<![A-Za-z0-9])[A-Z]{3}[ABCFGHJLPT][A-Z][0-9]{4}[A-Z](?![A-Za-z0-9])", "flags": "i" }
      ],
      "validator": "pan",
      "on_invalid": "drop",
      "validated_score": 0.8,
      "context": ["pan", "pan card", "pan no", "permanent account number", "income tax", "पैन"],
      "context_boost": 0.15,
      "ocr": {
        "pattern": "(?<![A-Za-z0-9])[A-Z0158]{5}[0-9OISB]{4}[A-Z0158](?![A-Za-z0-9])",
        "shape": "LLLLLDDDDL",
        "min_digits": 0,
        "score": 0.5
      }
    },
    {
      "id": "GSTIN",
      "label": "GST Identification Number",
      "phase": "P0",
      "severity": "medium",
      "priority": 95,
      "canonical": "alnum_upper",
      "patterns": [
        { "pattern": "(?<![A-Za-z0-9])[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z](?![A-Za-z0-9])", "flags": "i" }
      ],
      "validator": "gstin",
      "on_invalid": "base",
      "base_score": 0.35,
      "validated_score": 0.95,
      "context": ["gst", "gstin", "gst no", "gst number", "जीएसटी"],
      "context_boost": 0.3
